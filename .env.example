PLONE_EXTENSION_IDS=plone.app.caching:default,plonetheme.barceloneta:default,bibliotheca.policy:default
DEFAULT_LANGUAGE=fr
ACTIVE_BIGBANG=True
# zodb-pgjsonb (PostgreSQL) environment variables
PGJSONB_DB=library
PGJSONB_USER=library
PGJSONB_PASSWORD=
# S3 storage for blobs > 64KB (local Garage dev credentials, see `just garage-init`)
S3_BUCKET_NAME=zodb-blobs
S3_ACCESS_KEY=GK00e4c1534296750af2f176dd
S3_SECRET_KEY=a8a6fb84b937c940e51e783926fb491f09453d77110b6f46c62a3f6b95e6f9fc
# RelStorage (PostgreSQL) environment variables, only used as source
# database when migrating with `bin/zodb-convert migrate.cfg`
# RELSTORAGE_DB=library_relstorage
# RELSTORAGE_USER=library
# RELSTORAGE_PASSWORD=
# RELSTORAGE_HOSTNAME=db
# RELSTORAGE_PORT=5432
# pas.plugins.kimug environment variables
application_id=iA.Bibliotheca
# Example values for oidc plugin (local dev environment)
keycloak_admin_user=admin
keycloak_admin_password=admin
keycloak_allowed_groups="[iA.Bibliotheca]"
keycloak_client_id=plone
keycloak_client_secret=12345678910
keycloak_issuer=https://keycloak.127.0.0.1.nip.io/realms/plone
keycloak_realm=plone
keycloak_redirect_uris=http://localhost:8080/Plone/acl_users/oidc/callback
keycloak_url=https://keycloak.127.0.0.1.nip.io/
# Example values for oidc-sso-apps plugin (local dev environment)
SSO_APPS_ACCESS_GROUP=access_imio-apps-bibliotheca
