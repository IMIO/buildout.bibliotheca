{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus/Thanos",
      "description": "Datasource querying Thanos (or Prometheus) in k8s-app-staging",
      "type": "datasource",
      "pluginId": "prometheus"
    },
    {
      "name": "DS_TEMPO",
      "label": "Tempo",
      "description": "Tempo datasource receiving OTLP traces from plone.observability",
      "type": "datasource",
      "pluginId": "tempo"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "12.4"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "datasource",
      "id": "tempo",
      "name": "Tempo",
      "version": "1.0.0"
    }
  ],
  "title": "Bibliotheca - Plone Observability",
  "uid": "bibliotheca-observability",
  "tags": [
    "bibliotheca",
    "plone",
    "plone.observability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "DS_TEMPO",
        "label": "Tempo",
        "type": "datasource",
        "query": "tempo",
        "current": {}
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(plone_uptime_seconds, namespace)",
        "current": {
          "text": "bibliotheca",
          "value": "bibliotheca"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(plone_uptime_seconds{namespace=\"$namespace\"}, service)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "trace_service",
        "label": "Trace service (regex)",
        "description": "OTEL_SERVICE_NAME regex, e.g. bibliotheca-couvin-cloudbrine",
        "type": "textbox",
        "query": "bibliotheca-.*",
        "current": {
          "text": "bibliotheca-.*",
          "value": "bibliotheca-.*"
        }
      },
      {
        "name": "slow",
        "label": "Slow request threshold",
        "type": "custom",
        "query": "500ms,1s,2s,5s",
        "current": {
          "text": "1s",
          "value": "1s"
        },
        "options": [
          {
            "text": "500ms",
            "value": "500ms",
            "selected": false
          },
          {
            "text": "1s",
            "value": "1s",
            "selected": true
          },
          {
            "text": "2s",
            "value": "2s",
            "selected": false
          },
          {
            "text": "5s",
            "value": "5s",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Uptime (youngest pod)",
      "id": 1,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "min(plone_uptime_seconds{namespace=\"$namespace\", service=~\"$service\"})",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "description": "Lowest uptime among the selected pods: a small value means a pod restarted recently."
    },
    {
      "type": "stat",
      "title": "Plone version",
      "id": 5,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max by (plone_version, python_version) (plone_info{namespace=\"$namespace\", service=~\"$service\"})",
          "legendFormat": "Plone {{plone_version}} / Python {{python_version}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "type": "stat",
      "title": "Active threads (max)",
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(plone_threads_active{namespace=\"$namespace\", service=~\"$service\"})",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "description": "Highest thread count among the selected pods."
    },
    {
      "type": "stat",
      "title": "Peak RSS memory (max)",
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(plone_process_rss_bytes{namespace=\"$namespace\", service=~\"$service\"})",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "description": "Highest peak RSS among the selected pods. plone_process_rss_bytes comes from ru_maxrss: the peak resident size since start, not the current one."
    },
    {
      "type": "stat",
      "title": "CPU usage (total)",
      "id": 6,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(plone_process_cpu_seconds{namespace=\"$namespace\", service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "description": "User + system CPU time per second summed over the selected pods (100% = one full core)."
    },
    {
      "type": "stat",
      "title": "ZODB connections (max)",
      "id": 4,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(plone_zodb_connections{namespace=\"$namespace\", service=~\"$service\"})",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "description": "Highest number of open ZODB connections in a pod's pool."
    },
    {
      "type": "row",
      "title": "Requests",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 200,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Request rate (by auth)",
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (auth) (rate(plone_requests_total{namespace=\"$namespace\", service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{auth}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Error rate (by status code)",
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (status_code) (rate(plone_request_errors{namespace=\"$namespace\", service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{status_code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "links": [
        {
          "title": "Failed requests in Tempo",
          "url": "/explore?schemaVersion=1&orgId=1&panes={%22a%22:{%22datasource%22:%22${DS_TEMPO}%22%2C%22queries%22:%5B{%22refId%22:%22A%22%2C%22datasource%22:{%22type%22:%22tempo%22%2C%22uid%22:%22${DS_TEMPO}%22}%2C%22queryType%22:%22traceql%22%2C%22query%22:%22{resource.service.name=~%5C%22$trace_service%5C%22%20&&%20name=%5C%22ZPublisher.publish%5C%22%20&&%20status=error}%22}%5D%2C%22range%22:{%22from%22:%22${__from}%22%2C%22to%22:%22${__to}%22}}}",
          "targetBlank": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request duration (p50 / p95 / p99)",
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(plone_request_duration_seconds_bucket{namespace=\"$namespace\", service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(plone_request_duration_seconds_bucket{namespace=\"$namespace\", service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(plone_request_duration_seconds_bucket{namespace=\"$namespace\", service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "links": [
        {
          "title": "Slow requests in Tempo (> $slow)",
          "url": "/explore?schemaVersion=1&orgId=1&panes={%22a%22:{%22datasource%22:%22${DS_TEMPO}%22%2C%22queries%22:%5B{%22refId%22:%22A%22%2C%22datasource%22:{%22type%22:%22tempo%22%2C%22uid%22:%22${DS_TEMPO}%22}%2C%22queryType%22:%22traceql%22%2C%22query%22:%22{resource.service.name=~%5C%22$trace_service%5C%22%20&&%20name=%5C%22ZPublisher.publish%5C%22%20&&%20duration%20>%20$slow}%22}%5D%2C%22range%22:{%22from%22:%22${__from}%22%2C%22to%22:%22${__to}%22}}}",
          "targetBlank": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Average request duration",
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(plone_request_duration_seconds_sum{namespace=\"$namespace\", service=~\"$service\"}[$__rate_interval])) / sum(rate(plone_request_duration_seconds_count{namespace=\"$namespace\", service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "avg duration",
          "refId": "A"
        },
        {
          "expr": "max(plone_request_duration_seconds_max{namespace=\"$namespace\", service=~\"$service\"})",
          "legendFormat": "max (per scrape window)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "links": [
        {
          "title": "Slow requests in Tempo (> $slow)",
          "url": "/explore?schemaVersion=1&orgId=1&panes={%22a%22:{%22datasource%22:%22${DS_TEMPO}%22%2C%22queries%22:%5B{%22refId%22:%22A%22%2C%22datasource%22:{%22type%22:%22tempo%22%2C%22uid%22:%22${DS_TEMPO}%22}%2C%22queryType%22:%22traceql%22%2C%22query%22:%22{resource.service.name=~%5C%22$trace_service%5C%22%20&&%20name=%5C%22ZPublisher.publish%5C%22%20&&%20duration%20>%20$slow}%22}%5D%2C%22range%22:{%22from%22:%22${__from}%22%2C%22to%22:%22${__to}%22}}}",
          "targetBlank": true
        }
      ]
    },
    {
      "type": "row",
      "title": "ZODB",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 300,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "ZODB conflicts (by retry)",
      "id": 20,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (retry) (rate(plone_zodb_conflicts_total{namespace=\"$namespace\", service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "retry={{retry}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "ZODB loads / stores",
      "id": 21,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
