      },
      "targets": [
        {
          "expr": "sum(rate(plone_zodb_loads_total{namespace=\"$namespace\", service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "loads",
          "refId": "A"
        },
        {
          "expr": "sum(rate(plone_zodb_stores_total{namespace=\"$namespace\", service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "stores",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
